#pragma makedep header

#ifdef __WIDL__
#pragma winrt ns_prefix
#endif

import "xasyncprovider.idl";

import "propidl.idl";
import "inspectable.idl";
import "asyncinfo.idl";
import "eventtoken.idl";
import "windowscontracts.idl";
import "windows.foundation.idl";
import "windows.foundation.collections.idl";

// --- xgameruntime --- //

namespace XGameRuntime
{
    /* type-pruning version of XAsyncCompletionRoutine */
    delegate HRESULT XAsyncOperationCompletedHandlerImpl( [in, out] XAsyncBlock *asyncBlock );

    interface IXAsync<TResult>;

    [
        contract(Windows.Foundation.FoundationContract, 1.0),
        uuid(45edd235-e8a7-41ae-93c3-d0115669e8b7)
    ]
    interface IXAsync<TResult> : IInspectable
    {
        [propput] HRESULT Completed( [in] XAsyncOperationCompletedHandlerImpl *routine );
        [propget] HRESULT Completed( [out, retval] XAsyncOperationCompletedHandlerImpl **routine );
        HRESULT GetResults( [in] BOOLEAN wait, [out, retval] TResult *results );
    }
}