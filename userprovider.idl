#pragma makedep header

#ifdef __WIDL__
#pragma winrt ns_prefix
#endif

import "windows.data.json.idl";
import "xuser.idl";

struct endpoint;

[
    local,
    object
]
interface IUser : IUnknown
{
    HRESULT Initialize( [in] const XUserAddOptions options );
    HRESULT GetEndpointInfo( [in, string] const char *url, [out] struct endpoint *info );
    HRESULT GetAuthorization( [in, string] const WCHAR *relyingParty, [out, string] WCHAR **auth );
    HRESULT GetSignature( [in] UINT32 version, [in, string] const char *method, [in, string] const char *url, [in, string] const char *auth, [in] UINT32 bodySize, [in, size_is(bodySize)] const void *body, [out, size_is(104)] char *signature );
}
